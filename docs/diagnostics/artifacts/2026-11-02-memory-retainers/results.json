    "vutron-memory-full-final": [
      {
        "test": "real contextBridge cancellation releases only player callbacks and preserves the settings resume listener",
        "name": "real-preload-callbacks",
        "data": {
          "before": {
            "resume": 2,
            "play-from-osd": 1,
            "play": 1,
            "previous": 1,
            "next": 1,
            "repeat": 1,
            "repeat-shuffle": 1,
            "like": 1,
            "fm-trash": 1,
            "setPosition": 1,
            "increaseVolume": 1,
            "decreaseVolume": 1
          },
          "after": {
            "resume": 1,
            "play-from-osd": 0,
            "play": 0,
            "previous": 0,
            "next": 0,
            "repeat": 0,
            "repeat-shuffle": 0,
            "like": 0,
            "fm-trash": 0,
            "setPosition": 0,
            "increaseVolume": 0,
            "decreaseVolume": 0
          }
        }
      },
      {
        "test": "index preload disposers survive 100 cycles and preserve an unrelated listener",
        "name": "bridge-cycle-counts",
        "data": {
          "supported": true,
          "withForeign": 1,
          "after": 0
        }
      },
      {
        "test": "osdWin preload disposers survive 100 cycles and preserve an unrelated listener",
        "name": "bridge-cycle-counts",
        "data": {
          "supported": true,
          "withForeign": 1,
          "after": 0
        }
      },
      {
        "test": "unmount unregisters global messages, all IPC callbacks, asynchronous watches and MediaSession actions",
        "name": "player-lifecycle",
        "data": {
          "before": {
            "messages": 1,
            "ipc": 12,
            "mediaActions": 8
          },
          "after": {
            "messages": 0,
            "ipc": 0,
            "mediaActions": 0
          },
          "metadataCleared": true
        }
      },
      {
        "test": "unmount during asynchronous initialization cannot install late audio resources or global handlers",
        "name": "late-initialization",
        "data": {
          "contexts": 0,
          "ipc": 0,
          "media": 0
        }
      }
    ],

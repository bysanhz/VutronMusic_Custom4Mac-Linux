# .gitignore for NodeJS Projects
# ---------- Start of common ignore files

# Node artifact files
node_modules/
yarn.lock

# Log files
*.log

# dotenv environment variables file
.env

# JetBrains IDEs
.idea/
*.iml

# Visual Studio Code IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Applications
*.app
*.pkg
*.dmg
*.exe
*.war
*.deb

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ---------- End of common ignore files

# Project Files
dist/
dist-native/
release/
# ======== newADD start======
# 由 tools/generate-app-icons.js 在构建前从 new_icon.png 自动生成。
buildAssets/generated-icons/
# =========== newADD end ========
tests/results/
npm-debug.log
npm-debug.log.*
vite-plugin-electron.log
tmp/
